# ============================================================
# Bambu-Spaghetti-Destroyer Configuration Template
# Copy this file to .env and fill in your details:
#   copy .env.example .env
# ============================================================

# --- Telegram Bot Alerts ---
# Create your bot via @BotFather on Telegram to get your token.
# Get your numeric Chat ID by sending /start to @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bambu Lab Printer Config (Optional / Auto-discovered) ---
# Your credentials and serial can also be configured automatically
# by running: python cloud_bambu_auth.py
BAMBU_SERIAL=
BAMBU_HOST=
BAMBU_ACCESS_CODE=
